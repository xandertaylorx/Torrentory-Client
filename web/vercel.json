{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/chat/test",
      "destination": "/messenger.html"
    },
    {
      "source": "/chat",
      "destination": "/messenger.html"
    },
    {
      "source": "/messenger",
      "destination": "/messenger.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
