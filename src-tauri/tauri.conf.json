{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torrentory Client",
  "version": "0.1.7",
  "identifier": "com.torrentory.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Torrentory Client",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "A simple, native BitTorrent client.",
    "longDescription": "Torrentory Client is a minimal desktop BitTorrent client for content you are authorised to access.",
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent metainfo",
        "role": "Viewer",
        "mimeType": "application/x-bittorrent"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "Resources/torrentory-document.icns": "./icons/torrentory-document.icns"
      },
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}
